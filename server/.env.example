# --- Server ---
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# --- Database (MongoDB Atlas) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/playtest?retryWrites=true&w=majority

# --- Auth ---
# At least 32 random characters. Changing it invalidates every issued token.
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_EXPIRES_IN=1h

# --- Ollama (local AI) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2:3b
AI_TIMEOUT_MS=60000

# --- Vector search ---
VECTOR_INDEX_NAME=reports_vector_index
# Score scale is (1 + cosine) / 2, the same one Atlas $vectorSearch returns.
DUPLICATE_SIMILARITY_THRESHOLD=0.82

# --- Uploads ---
UPLOAD_DIR=uploads
